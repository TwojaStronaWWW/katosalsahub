# Szablon konfiguracji środowiskowej serwera (ISO 27001 - Zero Secrets in Git)
# Skopiuj ten plik jako .env na serwerze docelowym (poza webrootem) i uzupełnij rzeczywistymi wartościami.

# Sekret lub hash bcrypt/argon2/pbkdf2 hasła głównego administratora Salsopedii (fail-closed gdy puste)
KATO_ADMIN_SECRET=

# Klucz API i adres HTTPS wewnętrznego systemu zgłoszeń Helpdesk (osTicket)
OSTICKET_API_KEY=
OSTICKET_API_URL=https://hd.twojastronawww.pl/ticket_hook.php

# Scentralizowany adres odbiorczy dla leadów i zgłoszeń oraz kanał powiadomień Push Ntfy
CENTRAL_LEAD_EMAIL=poczatek.krzysztof@gmail.com
CONTACT_EMAIL=poczatek.krzysztof@gmail.com
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
