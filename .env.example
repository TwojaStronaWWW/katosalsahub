# Szablon konfiguracji środowiskowej serwera (ISO 27001 - Zero Secrets in Git)
# Skopiuj ten plik jako .env na serwerze docelowym i uzupełnij rzeczywistymi wartościami.

# Sekret lub hash bcrypt/argon2 hasła moderatora Salsopedii
KATO_ADMIN_SECRET=

# Klucz API i adres wewnętrznego systemu zgłoszeń Helpdesk (osTicket)
OSTICKET_API_KEY=
OSTICKET_API_URL=http://hd.twojastronawww.pl:8080/ticket_hook.php

# Scentralizowany adres odbiorczy dla leadów i zgłoszeń oraz kanał powiadomień Push Ntfy.sh
CENTRAL_LEAD_EMAIL=poczatek.krzysztof@gmail.com
CONTACT_EMAIL=poczatek.krzysztof@gmail.com
NTFY_TOPIC=
