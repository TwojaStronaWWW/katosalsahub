#!/usr/bin/env bash
# Pre-commit hook dla projektu Kato Salsa Hub & DancePuls
# Wzorzec jakościowy Enterprise Template (ISO 27001 Threat Protection)

set -e

echo "🔍 [pre-commit] Uruchamianie lokalnej bramy jakościowej (Quality Gate)..."

# 1. Blokada przypadkowego commitowania sekretów, baz danych, profili przeglądarek i artefaktów roboczych
FORBIDDEN_REGEX="(^|/)(\.env(\..*)?|config/secrets\.php|\.htpasswd)$|^docs/(audits|print)/|(^|/)\.chrome-[^/]+/|\.(pem|key|kdbx|bak)$|\.sqlite[0-9a-z_-]*$|(^|/)[^/]*token[^/]*\.json$"

if git diff --cached --name-only | grep -E "$FORBIDDEN_REGEX" | grep -vE "(^|/)\.env\.example$"; then
  echo "❌ [pre-commit] Wykryto zabroniony plik (sekret, klucz, baza danych lub artefakt roboczy) w indeksie Git!"
  echo "Usuń plik z indeksu poleceniem: git reset HEAD <plik>"
  exit 1
fi

# 2. Uruchomienie weryfikacji składni i testów jednostkowych
if ! npm run check; then
  echo "❌ [pre-commit] Testy lub weryfikacja składni nie powiodły się! Popraw błędy przed commitem."
  exit 1
fi

echo "✅ [pre-commit] Wszystkie testy przeszły pomyślnie! Zezwolono na commit."
exit 0
