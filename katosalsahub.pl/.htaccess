Options -Indexes

# Kanoniczne przekierowanie 301 z www na domenę bez www (eliminacja duplikatów w Google)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.katosalsahub\.pl$ [NC]
  RewriteRule ^(.*)$ https://katosalsahub.pl/$1 [R=301,L]
  RewriteRule ^zdjecia/?$ https://photos.app.goo.gl/faiU7NhFAgpTEPRt9 [R=302,L,NC]
</IfModule>

AddDefaultCharset UTF-8
AddType 'text/html; charset=UTF-8' html
AddType 'text/css; charset=UTF-8' css
AddType 'application/javascript; charset=UTF-8' js
AddType 'application/json; charset=UTF-8' json
AddType 'application/manifest+json; charset=UTF-8' webmanifest
AddType 'text/markdown; charset=UTF-8' md
AddType 'application/vnd.google-earth.kml+xml; charset=UTF-8' kml
AddType 'image/webp' webp

# Nagłówki bezpieczeństwa OWASP / ISO 27001 (microphone=(self) dla dyktowania głosowego w Asystencie AI)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Cross-Origin-Resource-Policy "same-site"
  Header always set Permissions-Policy "geolocation=(), microphone=(self), camera=()"
</IfModule>

# Wyłączenie wyświetlania błędów PHP na środowisku produkcyjnym (ISO 27001)
<IfModule mod_php.c>
  php_flag display_errors Off
  php_flag log_errors On
</IfModule>

# Blokada bezpośredniego dostępu HTTP do kolejki moderacji, kont moderatorów, kopii zapasowych i plików środowiskowych
<FilesMatch "(^#.*#|\.(bak|conf|dist|fla|in[ci]|log|orig|psd|sh|sql|sw[op]|tmp)|~|pending_edits\.json|moderators\.json|login_attempts\.json|\.env.*)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Walidacja świeżości dla Service Workera, widoków HTML, arkuszy CSS/JS i dynamicznej bazy Salsopedii (bez no-store pogarszającego TTFB dla Googlebota)
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|.*\.(html|css|js)|salsopedia\.json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
