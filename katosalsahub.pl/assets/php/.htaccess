# Ochrona danych osobowych, sesji, baz i plików CSV/JSON/kluczy (ISO 27001 & RODO)
<FilesMatch "\.(bak|csv|db|json|key|kdbx|lock|log|md|pem|sql|sqlite|sqlite3|txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
