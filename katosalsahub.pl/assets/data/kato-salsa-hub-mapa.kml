    <Style id="walkRoute">
      <LineStyle>
        <color>ffff6712</color>
        <width>5.5</width>
      </LineStyle>
    </Style>

    <!-- ==================== WARSTWA 1: MIEJSCA POTAŃCÓWEK, WIATA I TOALETY ==================== -->
    <Folder>
      <name>Miejsca potańcówek, wiata i toalety</name>

      <Placemark>
        <name>💃 Kamienny Krąg – Dolina Trzech Stawów (Plener)</name>
        <description>Główne miejsce plenerowych potańcówek Kato Salsa Hub w Dolinie Trzech Stawów – przy przystani wodnej, obok restauracji La Cantina i Campingu 215 (ul. Trzech Stawów 22).</description>
        <styleUrl>#danceSpot</styleUrl>
        <Point>
          <coordinates>19.046362,50.2449289,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>Strefa parkietu: Kamienny Krąg</name>
        <description>Obrys plenerowego parkietu tanecznego na Kamiennym Kręgu w Dolinie Trzech Stawów.</description>
        <styleUrl>#polyDance</styleUrl>
        <Polygon>
          <outerBoundaryIs>
            <LinearRing>
              <tessellate>1</tessellate>
              <coordinates>
                19.0464984,50.2450405,0
                19.0462301,50.2450422,0
                19.0462382,50.2448741,0
                19.0465064,50.2448775,0
                19.0464984,50.2450405,0
              </coordinates>
            </LinearRing>
          </outerBoundaryIs>
        </Polygon>
      </Placemark>

      <Placemark>
        <name>🍹 Wolni Ludzie – Tańczymy pod dachem (ul. Mariacka 2)</name>
        <description>Nasza miejscówka pod dachem w samym sercu Katowic (ul. Mariacka 2 / róg ul. Mielęckiego, dawny Złoty Róg). Od niedzieli tańczymy tu pod dachem w karaibskim klimacie! W niedziele oraz codziennie po godz. 17:00 wszystkie parkingi miejskie wokół lokalu oraz pod NOSPR-em są DARMOWE.</description>
        <styleUrl>#indoorSpot</styleUrl>
        <Point>
          <coordinates>19.0248325,50.2577281,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>Strefa lokalu: Wolni Ludzie (ul. Mariacka 2)</name>
        <description>Lokal Wolni Ludzie na rogu ul. Mariackiej 2 i ul. Mielęckiego – potańcówki pod dachem.</description>
        <styleUrl>#polyDance</styleUrl>
        <Polygon>
          <outerBoundaryIs>
            <LinearRing>
              <tessellate>1</tessellate>
              <coordinates>
                19.02472,50.25781,0
                19.02496,50.25781,0
                19.02496,50.25765,0
                19.02472,50.25765,0
                19.02472,50.25781,0
              </coordinates>
            </LinearRing>
          </outerBoundaryIs>
        </Polygon>
      </Placemark>

      <Placemark>
        <name>💃 Amfiteatr pod NOSPR-em – Strefa Kultury</name>
        <description>Miejsce plenerowych potańcówek Kato Salsa Hub w Katowickiej Strefie Kultury (pl. Wojciecha Kilara 1, od wschodniej strony gmachu NOSPR przy fontannach).</description>
        <styleUrl>#danceSpot</styleUrl>
        <Point>
          <coordinates>19.0304412,50.2641287,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>☔ Wiata – gdzie tańczymy w razie deszczu</name>
        <description>Zadaszona wiata przy północnym brzegu Stawu Kajakowego (obok przystani UKS 4 Katowice i SUP Tomi, ul. Trzech Stawów 10). Tutaj przenosimy się i tańczymy w razie deszczu!</description>
        <styleUrl>#danceSpot</styleUrl>
        <Point>
          <coordinates>19.0471200,50.2485200,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>🚻 Toaleta Publiczna – Aleja Spacerowa / Plaża (do 20:00)</name>
        <description>Toaleta miejska przy alei spacerowej i plaży po północno-zachodniej stronie Stawu Kajakowego (czynna do godz. 20:00).</description>
        <styleUrl>#infoSpot</styleUrl>
        <Point>
          <coordinates>19.0421245,50.2480851,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>🚻 Toaleta – przy AMO Pizza / ul. Trzech Stawów</name>
        <description>Toaleta po wschodniej stronie Stawu Kajakowego (przy restauracji AMO - Pizza Pasta Amore, ul. Trzech Stawów 15, ok. 2 min pieszo od Kamiennego Kręgu).</description>
        <styleUrl>#infoSpot</styleUrl>
        <Point>
          <coordinates>19.0484200,50.2459200,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>🚻 Toaleta – za wiaduktem A4 / ul. Trzech Stawów</name>
        <description>Toaleta przy ul. Trzech Stawów tuż na południe od wiaduktu autostrady A4 (w stronę rolkostrady, ok. 3 min pieszo od Kamiennego Kręgu).</description>
        <styleUrl>#infoSpot</styleUrl>
        <Point>
          <coordinates>19.0473500,50.2419500,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>🚌 Przystanek: Kolonia Zuzanna / Porcelanowa</name>
        <description>Najbliższy przystanek autobusowy od północnej strony Doliny Trzech Stawów (ok. 7 min pieszo do Kamiennego Kręgu). Autobusy: 1, 1N, 4, 672N, 673, 674, 900, 920.</description>
        <styleUrl>#infoSpot</styleUrl>
        <Point>
          <coordinates>19.0489502,50.2496877,0</coordinates>
        </Point>
      </Placemark>
    </Folder>

    <!-- ==================== WARSTWA 2: PARKINGI I TRASA PIESZA – DOLINA TRZECH STAWÓW ==================== -->
    <Folder>
      <name>Parkingi i trasa – Dolina Trzech Stawów</name>

      <Placemark>
        <name>⭐ Parking Rekomendowany – Dolina 3 Stawów Południe / Rolkostrada (13 min)</name>
        <description>Główny rekomendowany, duży i bezpłatny parking na południowym odcinku ul. Trzech Stawów (przy rolkostradzie na Muchowcu). Proste dojście asfaltową aleją prosto do Kamiennego Kręgu (13 min pieszo lub 4 min na rolkach).</description>
        <styleUrl>#parkingRec</styleUrl>
        <Point>
          <coordinates>19.0470498,50.2370851,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>Strefa: Parking Rekomendowany – Południe / Rolkostrada</name>
        <description>Obrys dużego bezpłatnego parkingu rekomendowanego przy rolkostradzie.</description>
        <styleUrl>#polyParking</styleUrl>
        <Polygon>
          <outerBoundaryIs>
            <LinearRing>
              <tessellate>1</tessellate>
              <coordinates>
                19.0475698,50.2375334,0
                19.0463279,50.2373413,0
                19.0466712,50.2365453,0
                19.0479587,50.2367477,0
                19.0475698,50.2375334,0
              </coordinates>
            </LinearRing>
          </outerBoundaryIs>
        </Polygon>
      </Placemark>

      <Placemark>
        <name>🚶 Trasa piesza: Parking Rekomendowany ↔ Kamienny Krąg (13 min)</name>
        <description>Prosta, oświetlona trasa piesza (oraz dla rolek i rowerów) wzdłuż alei spacerowej i ul. Trzech Stawów od Parkingu Rekomendowanego prosto na parkiet Kamiennego Kręgu.</description>
        <styleUrl>#walkRoute</styleUrl>
        <LineString>
          <tessellate>1</tessellate>
          <coordinates>
            19.0470498,50.2370851,0
            19.0473800,50.2371500,0
            19.0472800,50.2381000,0
            19.0472000,50.2392000,0
