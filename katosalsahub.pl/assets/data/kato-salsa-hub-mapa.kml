    <!-- ==================== WARSTWA 1: MIEJSCA POTAŃCÓWEK, WIATA I TOALETY ==================== -->
    <Folder>
      <name>Miejsca potańcówek, wiata i toalety</name>
      <Placemark>
        <name>💃 Kamienny Krąg – Dolina Trzech Stawów (Plener)</name>
        <description>Główne miejsce plenerowych potańcówek Kato Salsa Hub w Dolinie Trzech Stawów – przy przystani wodnej, obok restauracji La Cantina i Campingu 215 (ul. Trzech Stawów 22). Strona: https://katosalsahub.pl/</description>
        <styleUrl>#icon-1899-DB4436</styleUrl>
        <Point>
          <coordinates>19.046362,50.2449289,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Strefa parkietu: Kamienny Krąg</name>
        <description>Obrys plenerowego parkietu tanecznego na Kamiennym Kręgu w Dolinie Trzech Stawów.</description>
        <styleUrl>#poly-0288D1-3000-89</styleUrl>
        <Polygon>
          <outerBoundaryIs>
            <LinearRing>
              <tessellate>1</tessellate>
              <coordinates>
                19.046498,50.24504,0
                19.04623,50.245042,0
                19.046238,50.244874,0
                19.046506,50.244878,0
                19.046498,50.24504,0
              </coordinates>
            </LinearRing>
          </outerBoundaryIs>
        </Polygon>
      </Placemark>
      <Placemark>
        <name>🍹 Wolni Ludzie – Tańczymy pod dachem (ul. Mariacka 2)</name>
        <description>Nasza miejscówka pod dachem w samym sercu Katowic (ul. Mariacka 2 / róg ul. Mielęckiego, dawny Złoty Róg). W każdą niedzielę (15:00–18:00) tańczymy tu Salsę Cubana, Timbę, Rueda de Casino i Son! W niedziele oraz codziennie po godz. 17:00 wszystkie parkingi miejskie wokół lokalu oraz pod NOSPR-em są DARMOWE.</description>
        <styleUrl>#icon-1899-DB4436</styleUrl>
        <Point>
          <coordinates>19.0248325,50.2577281,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Strefa lokalu: Wolni Ludzie (ul. Mariacka 2)</name>
        <description>Lokal Wolni Ludzie na rogu ul. Mariackiej 2 i ul. Mielęckiego – potańcówki pod dachem.</description>
        <styleUrl>#poly-0288D1-3000-89</styleUrl>
        <Polygon>
          <outerBoundaryIs>
            <LinearRing>
              <tessellate>1</tessellate>
              <coordinates>
                19.02472,50.25781,0
                19.02472,50.25765,0
                19.02496,50.25765,0
                19.02496,50.25781,0
                19.02472,50.25781,0
              </coordinates>
            </LinearRing>
          </outerBoundaryIs>
        </Polygon>
      </Placemark>
      <Placemark>
        <name>💃 Amfiteatr pod NOSPR-em – Strefa Kultury</name>
        <description>Miejsce plenerowych potańcówek Kato Salsa Hub w Katowickiej Strefie Kultury (pl. Wojciecha Kilara 1, od wschodniej strony gmachu NOSPR przy fontannach).</description>
        <styleUrl>#icon-1899-DB4436</styleUrl>
        <Point>
          <coordinates>19.0304412,50.2641287,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>☔ Wiata – gdzie tańczymy w razie deszczu</name>
        <description>Zadaszona wiata przy północnym brzegu Stawu Kajakowego (obok przystani UKS 4 Katowice i SUP Tomi, ul. Trzech Stawów 10). Tutaj przenosimy się i tańczymy w razie deszczu!</description>
        <styleUrl>#icon-1899-DB4436</styleUrl>
        <Point>
          <coordinates>19.0471200,50.2485200,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>🚻 Toaleta Publiczna – Aleja Spacerowa / Plaża (do 20:00)</name>
        <description>Toaleta miejska przy alei spacerowej i plaży po północno-zachodniej stronie Stawu Kajakowego (czynna do godz. 20:00).</description>
        <styleUrl>#icon-1899-0F9D58</styleUrl>
        <Point>
          <coordinates>19.0421245,50.2480851,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>🚻 Toaleta – przy AMO Pizza / ul. Trzech Stawów</name>
        <description>Toaleta po wschodniej stronie Stawu Kajakowego (przy restauracji AMO - Pizza Pasta Amore, ul. Trzech Stawów 15, ok. 2 min pieszo od Kamiennego Kręgu).</description>
        <styleUrl>#icon-1899-0F9D58</styleUrl>
        <Point>
          <coordinates>19.0484200,50.2459200,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>🚻 Toaleta – za wiaduktem A4 / ul. Trzech Stawów</name>
        <description>Toaleta przy ul. Trzech Stawów tuż na południe od wiaduktu autostrady A4 (w stronę rolkostrady, ok. 3 min pieszo od Kamiennego Kręgu).</description>
        <styleUrl>#icon-1899-0F9D58</styleUrl>
        <Point>
          <coordinates>19.0473500,50.2419500,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>🚌 Przystanek: Kolonia Zuzanna / Porcelanowa</name>
        <description>Najbliższy przystanek autobusowy od północnej strony Doliny Trzech Stawów (ok. 7 min pieszo do Kamiennego Kręgu). Autobusy: 1, 1N, 4, 672N, 673, 674, 900, 920.</description>
        <styleUrl>#icon-1899-0F9D58</styleUrl>
        <Point>
          <coordinates>19.0489502,50.2496877,0</coordinates>
        </Point>
      </Placemark>
    </Folder>

    <!-- ==================== WARSTWA 2: SZKOŁY TAŃCA I KLUBY – KATOWICE ==================== -->
    <Folder>
      <name>Szkoły Tańca i Kluby – Katowice</name>

      <Placemark>
        <name>🔴 Szkoła Tańca La Clave Katowice (ul. Chorzowska 11)</name>
        <description>Jedna z głównych szkół tańca w Katowicach (ul. Chorzowska 11, tuż obok Spodka i Ronda Ziętka; zał. 2013 przez Sebastiana Ciosińskiego). Style: Salsa Cubana (Casino), Rueda de Casino, Timba, Son Cubano, Rumba, Salsa NY On2, Bachata, Kizomba. Honoruje MultiSport Plus, Medicover Sport, FitProfit i PZU Sport; karnety bezterminowe. Grafik i cennik: https://katosalsahub.pl/grafik.html | https://laclave.pl</description>
        <styleUrl>#icon-1899-0288D1</styleUrl>
        <Point>
          <coordinates>19.0187802,50.2660441,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>🟡 Szkoła Tańca Good Mood – Siedziba Główna (ul. Paderewskiego 35)</name>
        <description>Popularna katowicka szkoła tańca przy ul. Ignacego Paderewskiego 35 (zał. przez Adriana „Dronsona” Dronszczyka). Style: Salsa LA (On1/On2), Salsa Cubana, Bachata, Kizomba, Zouk Brazylijski, West Coast Swing, Tango, Latino Solo. Własny parking pod budynkiem; honoruje MultiSport, Medicover Sport i FitProfit. Grafik i cennik: https://katosalsahub.pl/grafik.html | https://goodmood.dance</description>
        <styleUrl>#icon-1899-0288D1</styleUrl>
        <Point>
          <coordinates>19.0399055,50.2536322,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>🔵 Szkoła Tańca Mil Pasos Katowice (ul. Kamienna 4)</name>
        <description>Duża szkoła tańca w Śródmieściu Katowic (ul. Kamienna 4, boczna ul. Mikołowskiej). Style: Salsa Cubana, Timba, Rumba, Bachata Sensual, Kizomba Fusion, Urban Kiz, Zouk Brazylijski, Bachazouk, Lady Styling i Bodymovement. Honoruje MultiSport Plus, Medicover Sport i FitProfit. Grafik i cennik: https://katosalsahub.pl/grafik.html | https://milpasoskatowice.pl</description>
        <styleUrl>#icon-1899-0288D1</styleUrl>
        <Point>
          <coordinates>19.0120548,50.2569002,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>🟢 Taneczna Kompania – Szkoła Tańca (ul. Kościuszki 227)</name>
        <description>Szkoła tańca na katowickim Brynowie (ul. Tadeusza Kościuszki 227, obok parku trampolin Jumpcity), założona przez Ulę Miś i Michała Saternusa. Specjalizuje się w tańcach socialowych: Bachata, Kizomba / Urban Kiz, Salsa, Latino Solo, Tango Argentyńskie oraz Taniec Towarzyski. Duży, wygodny parking bezpośrednio przy budynku. Strona: https://tanecznakompania.pl</description>
        <styleUrl>#icon-1899-0288D1</styleUrl>
        <Point>
          <coordinates>18.9894412,50.2247965,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>🟠 Gravitacja / Punkt 44 – Good Mood &amp; Dance++ (ul. Gliwicka 44)</name>
        <description>Przestrzeń taneczno-klubowa w Centrum Rozrywki Punkt 44 (ul. Gliwicka 44, Załęże). Odbywają się tu regularne kursy Salsy Kubańskiej i Bachaty Szkoły Tańca Good Mood (m.in. z Danielem „Kokoszem” Machalicą) oraz cykliczne imprezy kizombowe i bachatowe Dance++ (Dance Plus Plus). Duży bezpłatny parking Centrum Punkt 44.</description>
        <styleUrl>#icon-1899-0288D1</styleUrl>
        <Point>
          <coordinates>19.0059609,50.2625240,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>🟣 KIZLAB – Niedzielne Imprezy KIZLAB Sundays (ul. Sobieskiego 11)</name>
        <description>Lokalizacja cyklicznych wydarzeń, warsztatów i praktyk KIZLAB Sundays w Katowicach (ul. Jana III Sobieskiego 11), współtworzonych przez Elę Stępień i Michała Rozewskiego. Kultura Kizomby, Urban Kiz, Semby, Tarraxo i Douceur. FB: https://www.facebook.com/kizlabkatowice</description>
        <styleUrl>#icon-1899-0288D1</styleUrl>
        <Point>
          <coordinates>19.0119432,50.2619208,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>🟣 KIZLAB Studio – Warsztaty i Praktisy (ul. 3 Maja 11)</name>
        <description>Przestrzeń warsztatowa KIZLAB w ścisłym centrum Katowic (ul. 3 Maja 11, tuż obok Dworca PKP i pl. Szewczyka) – treningi techniczne Lead &amp; Follow, Kizomba, Urban Kiz, Tarraxo i nocne praktisy.</description>
        <styleUrl>#icon-1899-0288D1</styleUrl>
        <Point>
          <coordinates>19.0190676,50.2597078,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>💃 VAMULA.pl – Akademia Kizomby Pedro y Bella (ul. Wojewódzka 29)</name>
        <description>Katowicka akademia tańca przy ul. Wojewódzkiej 29 założona przez duet Pedro y Bella. Tradycyjna Kizomba, Semba, Kompa, Tarraxinha, weekendowe bootcampy oraz imprezy Kizombada.</description>
        <styleUrl>#icon-1899-0288D1</styleUrl>
        <Point>
          <coordinates>19.0282058,50.2555572,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>💃 Nova Szkoła Tańca / Evolution (al. Korfantego 4)</name>
        <description>Szkoła tańca w ścisłym centrum Katowic (al. Wojciecha Korfantego 4, przy Rynku) działająca od 2005 r. Zajęcia z Salsy Kubańskiej, Bachaty, Reggaetonu, Cubatonu i Latino Solo (m.in. warsztaty Cuban Day z rodowitą Kubanką Reglą Marią Peñalver Hernández). Strona: https://novaszkolatanca.pl</description>
        <styleUrl>#icon-1899-0288D1</styleUrl>
        <Point>
          <coordinates>19.0214962,50.2619640,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>💃 Evolution Dance Studio (ul. Sokolska 31)</name>
        <description>Katowickie studio taneczne przy ul. Sokolskiej 31 (historyczny adres taneczny w centrum Katowic). Zajęcia z technik latynoskich, Bachaty, Salsy oraz Latino Solo. Strona: https://www.evolutiondancestudio.pl</description>
        <styleUrl>#icon-1899-0288D1</styleUrl>
        <Point>
          <coordinates>19.0204566,50.2629985,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>💃 Śląska Szkoła Tańca – Dariusz Kurzeja (ul. Paderewskiego 46)</name>
        <description>Jedna z najdłużej działających szkół tańca na Górnym Śląsku (od 1992 r., zał. Dariusz Kurzeja; sala w Katowicach przy ul. Paderewskiego 46). Kursy Salsy Kubańskiej, Bachaty, Mambo, Rumby i Tańca Towarzyskiego. Strona: https://tanca.com.pl</description>
        <styleUrl>#icon-1899-0288D1</styleUrl>
        <Point>
          <coordinates>19.0371750,50.2502547,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
