            19.0470380,50.2412490,0
            19.0470930,50.2417070,0
            19.0470950,50.2422970,0
            19.0471280,50.2429810,0
            19.0470800,50.2435570,0
            19.0467180,50.2435290,0
            19.0464060,50.2436540,0
            19.0463360,50.2438050,0
            19.0464120,50.2442610,0
            19.0463930,50.2444430,0
            19.0462560,50.2446190,0
            19.0463600,50.2447510,0
            19.0463250,50.2448580,0
            19.0463620,50.2449289,0
          </coordinates>
        </LineString>
      </Placemark>

      <Placemark>
        <name>⭐ Parking Najbliższy – La Cantina / Camping 215 (1 min)</name>
        <description>Parking tuż przy samym Kamiennym Kręgu (ul. Trzech Stawów 22). Najbliższy (1 min pieszo), ale w pogodne weekendy bardzo szybko się zapełnia.</description>
        <styleUrl>#parkingRec</styleUrl>
        <Point>
          <coordinates>19.0474309,50.2448644,0</coordinates>
        </Point>
      </Placemark>

