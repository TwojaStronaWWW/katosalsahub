{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Quality Gate (npm run check)",
      "type": "shell",
      "command": "npm run check",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Sync All (Events + Schedules + Layout)",
      "type": "shell",
      "command": "npm run sync:all",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Start Dev Server (localhost:3000)",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
